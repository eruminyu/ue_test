.vs/
.idea/
*.sln
*.suo
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Compiled files
*.obj
*.pch
*.dll
*.lib
*.exe
*.pdb

# --- SoulCombat (UE 5.8 project in ./SoulCombat) ---
SoulCombat/Binaries/
SoulCombat/Intermediate/
SoulCombat/Saved/
SoulCombat/DerivedDataCache/
SoulCombat/Platforms/
SoulCombat/Build/
*.uproject.bak
*_BuiltData.uasset

# Template content is copied from the engine by Tools/Setup-Project.ps1, so only the
# assets made for this project (Content/SoulCombat and its external actors) are committed.
SoulCombat/Content/*
!SoulCombat/Content/SoulCombat/
!SoulCombat/Content/__ExternalActors__/
SoulCombat/Content/__ExternalActors__/*
!SoulCombat/Content/__ExternalActors__/SoulCombat/
!SoulCombat/Content/__ExternalObjects__/
SoulCombat/Content/__ExternalObjects__/*
!SoulCombat/Content/__ExternalObjects__/SoulCombat/
